# COMPARISON BETWEEN VARIETIES AND BETWEEN PHOTOS OF THE SAME VARI --------


# CAPIRO: COMPARISON BETWEEN VARIETIES AND BETWEEN PHOTOS OF THE SAME VARIETY
# Companion to Capiro_analisis_color.R. R >= 4.1.
# 1. Run the general analysis first to generate analisis_completo.rds.
# 2. Change CARPETA_ENTRADA and run this entire file.
# Uses the selected images and filters from the general analysis.
# Does not download images or modify previous results.
#
# A nominal variety is defined by producto_url, not by color.
# This does not confirm genetic identity or cultivar equivalence.
# A catalog photo is not an independent biological replicate.
#
# If the same variety has multiple entries/URLs or alternative names:
# create mapa_variedades.csv in CARPETA_ENTRADA with the columns
# producto_url,variedad_id,variedad_nombre and cover ALL included URLs.
# A template is exported. Similar names are not merged automatically.
#
# The EMD distance preserves proportions and uses CIEDE2000 (D65) as the cost.
# Do not apply individual DeltaE00 thresholds to this distance between palettes.
# No tests of equality or statistical significance are performed using photos
# as replicates.
###

CARPETA_ENTRADA <- "D:/R/Capiro_resultados"
ARCHIVO_RDS <- ""                      # Vacio: ultimo analisis general guardado
MAX_IMAGENES <- 400L                   # n(n-1)/2 transportes; aumentar si es necesario
VARIEDADES_POR_PAGINA <- 20L
TOP_PARES <- 8L
GUARDAR_PDF <- TRUE
TOL_NUMERICA <- 1e-7                  # Solo para empates numericos, no umbral biologico
SEMILLA <- 42L

comparar_variedades <- function(carpeta = CARPETA_ENTRADA, archivo_rds = ARCHIVO_RDS,
                                base = NULL) {
  pk <- c("readr", "dplyr", "tidyr", "ggplot2", "farver", "lpSolve", "patchwork")
  faltan <- pk[!vapply(pk, requireNamespace, logical(1), quietly = TRUE)]
  if (length(faltan)) stop("Instalar primero: install.packages(c(",
                           paste(sprintf('"%s"', faltan), collapse = ", "), "))")
  suppressPackageStartupMessages({ library(dplyr); library(tidyr); library(ggplot2) })
  set.seed(SEMILLA)
  if (is.null(base)) {
    if (!nzchar(archivo_rds)) {
      archivos <- list.files(file.path(carpeta, "Analisis_R"), pattern = "^analisis_completo\\.rds$",
                             recursive = TRUE, full.names = TRUE)
      if (!length(archivos)) stop("Ejecutar primero Capiro_analisis_color.R o indicar ARCHIVO_RDS.")
      archivo_rds <- archivos[which.max(file.info(archivos)$mtime)]
    }
    if (!file.exists(archivo_rds)) stop("No existe ARCHIVO_RDS: ", archivo_rds)
    base <- readRDS(archivo_rds)
    message("Usando resultados de: ", normalizePath(archivo_rds, winslash = "/"))
  }
  exigir <- function(x, cols, nombre) {
    if (is.null(x) || !all(cols %in% names(x))) stop(nombre, ": columnas ausentes. Regenerar analisis general.")
  }
  met <- as.data.frame(base$imagenes)
  pal <- as.data.frame(base$paletas)
  exigir(met, c("imagen_id", "producto_url", "nombre", "L_media", "a_media", "b_media"), "Imagenes")
  exigir(pal, c("imagen_id", "L", "a", "b", "Hex", "Proporcion"), "Paletas")
  if (!nrow(met) || anyNA(met$imagen_id) || anyDuplicated(met$imagen_id) || anyNA(met$producto_url))
    stop("Identificadores de imagenes invalidos o sin fotos.")
  if (nrow(met) > MAX_IMAGENES) stop("Hay ", nrow(met), " fotos. Revisar seleccion o aumentar MAX_IMAGENES.")
  if (!all(vapply(met[c("L_media", "a_media", "b_media")], is.numeric, logical(1))))
    stop("Las medias Lab deben ser numericas.")
  if (!"sha256" %in% names(met)) met$sha256 <- NA_character_
  sin_nombre <- is.na(met$nombre) | !nzchar(trimws(met$nombre))
  met$nombre[sin_nombre] <- met$producto_url[sin_nombre]
  salida_base <- file.path(carpeta, "Analisis_variedades")
  dir.create(salida_base, recursive = TRUE, showWarnings = FALSE)
  salida <- file.path(salida_base, paste0("ejecucion_", format(Sys.time(), "%Y%m%d_%H%M%S")))
  if (dir.exists(salida)) salida <- tempfile("ejecucion_", tmpdir = salida_base)
  dir.create(salida)
  for (s in c("figuras", "tablas")) dir.create(file.path(salida, s))
  csv <- function(x, nombre) readr::write_excel_csv(as.data.frame(x),
                                                    file.path(salida, "tablas", paste0(nombre, ".csv")), na = "")
  guardar <- function(p, nombre, w = 12, h = 7) {
    ggsave(file.path(salida, "figuras", paste0(nombre, ".png")), p, width = w, height = h,
           units = "in", dpi = 300, bg = "white")
    if (GUARDAR_PDF) ggsave(file.path(salida, "figuras", paste0(nombre, ".pdf")), p,
                            width = w, height = h, units = "in", bg = "white", device = "pdf")
  }
  tema <- function() theme_minimal(base_size = 12) + theme(
    plot.title = element_text(face = "bold", colour = "#173F58"), panel.grid.minor = element_blank(),
    plot.subtitle = element_text(size = 10, colour = "#526577"))
  resumen <- function(x) paste(sort(unique(x[!is.na(x)])), collapse = "; ")
  media <- function(x) if (length(x) && all(is.finite(x))) mean(x) else NA_real_
  mediana <- function(x) if (length(x) && all(is.finite(x))) median(x) else NA_real_
  maximo <- function(x) if (length(x) && all(is.finite(x))) max(x) else NA_real_
  # -- 1. IDENTIDAD NOMINAL: AUDITAR NOMBRES, NO ADIVINAR SINONIMOS --------
  plantilla <- met |> group_by(producto_url) |> summarise(
    variedad_id = first(producto_url), variedad_nombre = first(nombre), .groups = "drop")
  csv(plantilla, "plantilla_mapa_variedades")
  ruta_mapa <- file.path(carpeta, "mapa_variedades.csv")
  mapa <- plantilla
  if (file.exists(ruta_mapa)) {
    mapa <- readr::read_csv(ruta_mapa, col_types = readr::cols(.default = readr::col_character()),
                            show_col_types = FALSE, progress = FALSE)
    exigir(mapa, c("producto_url", "variedad_id", "variedad_nombre"), "mapa_variedades.csv")
    if (anyDuplicated(mapa$producto_url) || anyNA(mapa[c("producto_url", "variedad_id", "variedad_nombre")]) ||
        any(!nzchar(trimws(as.matrix(mapa[c("producto_url", "variedad_id", "variedad_nombre")])))))
      stop("Mapa: URLs repetidas o identificadores/nombres vacios.")
    if (length(setdiff(met$producto_url, mapa$producto_url))) stop("El mapa no cubre todas las URLs incluidas.")
    ambiguos <- mapa |> group_by(variedad_id) |> summarise(N = n_distinct(variedad_nombre), .groups = "drop")
    if (any(ambiguos$N != 1)) stop("El mapa asigna varios nombres a un mismo variedad_id.")
    mapa <- mapa |> select(producto_url, variedad_id, variedad_nombre)
  }
  met <- met |> left_join(mapa, by = "producto_url")
  nominal <- met |> mutate(nombre_normalizado = tolower(gsub("[[:space:]]+", " ", trimws(nombre)))) |>
    group_by(nombre_normalizado) |> summarise(N_fichas = n_distinct(producto_url),
                                              N_variedades = n_distinct(variedad_id), Nombres = resumen(nombre),
                                              URLs = resumen(producto_url), .groups = "drop")
  csv(nominal, "auditoria_nombres")
  csv(nominal |> filter(N_fichas > 1), "nombres_repetidos_entre_fichas")
  csv(met |> select(imagen_id, producto_url, nombre, variedad_id, variedad_nombre), "identidad_por_imagen")
  # Los filtros de seleccion/deduplicacion del analisis general ya se aplicaron.
  pal <- pal |> select(imagen_id, L, a, b, Hex, Proporcion) |>
    inner_join(met |> select(imagen_id, variedad_id), by = "imagen_id")
  exigir(pal, c("L", "a", "b", "Proporcion"), "Paletas")
  if (anyNA(pal[c("L", "a", "b", "Proporcion")]) ||
      any(!is.finite(as.matrix(pal[c("L", "a", "b", "Proporcion")])))) stop("Datos Lab/pesos no finitos.")
  masas <- pal |> group_by(imagen_id) |> summarise(masa = sum(Proporcion), .groups = "drop")
  if (any(pal$Proporcion < 0) || any(abs(masas$masa - 1) > .001) ||
      !setequal(masas$imagen_id, met$imagen_id)) stop("Paletas incompletas o masas invalidas.")
  pal <- pal |> left_join(masas, by = "imagen_id") |> mutate(Peso = Proporcion / masa) |> filter(Peso > 0)
  # -- 2. DISTANCIAS ENTRE FOTOS -----------------------------------------
  delta <- function(a, b) farver::compare_colour(as.matrix(a), as.matrix(b),
                                                 from_space = "lab", to_space = "lab", method = "cie2000", white_from = "D65", white_to = "D65")
  emd <- function(a, b) {
    m <- nrow(a); q <- nrow(b)
    coste <- delta(a[c("L", "a", "b")], b[c("L", "a", "b")])
    A <- rbind(kronecker(matrix(1, 1, q), diag(m)), kronecker(diag(q), matrix(1, 1, m)))
    wa <- a$Peso / sum(a$Peso); wb <- b$Peso / sum(b$Peso)
    fit <- lpSolve::lp("min", as.vector(coste), A, rep("=", m + q), c(wa, wb), all.int = FALSE)
    if (fit$status != 0) stop("No convergio el transporte optimo.")
    flujo <- matrix(fit$solution, m, q)
    if (max(abs(rowSums(flujo) - wa), abs(colSums(flujo) - wb)) > 1e-6) stop("Masas no conservadas.")
    max(0, fit$objval)
  }
  fotos <- met$imagen_id; nf <- length(fotos)
  pf <- lapply(fotos, function(id) pal |> filter(imagen_id == id))
  DF <- matrix(0, nf, nf, dimnames = list(fotos, fotos))
  message("Comparando ", nf, " fotos: ", choose(nf, 2), " pares.")
  if (nf > 1) for (i in seq_len(nf - 1L)) {
    for (j in seq.int(i + 1L, nf)) DF[i,j] <- DF[j,i] <- emd(pf[[i]], pf[[j]])
    if (i %% 20 == 0) message("  Fila ", i, " de ", nf - 1L)
  }
  if (any(!is.finite(DF))) stop("Distancias no finitas.")
  csv(data.frame(imagen_id = fotos, DF, check.names = FALSE), "matriz_EMD_fotos")
  pares_fotos <- data.frame(imagen_1 = character(), imagen_2 = character(),
                            variedad_1 = character(), variedad_2 = character(), EMD = numeric(),
                            Tipo = character(), Hash_identico = logical())
  if (nf > 1) {
    ix <- which(upper.tri(DF), arr.ind = TRUE)
    pares_fotos <- data.frame(imagen_1 = fotos[ix[,1]], imagen_2 = fotos[ix[,2]],
                              variedad_1 = met$variedad_id[ix[,1]], variedad_2 = met$variedad_id[ix[,2]], EMD = DF[ix],
                              Hash_identico = !is.na(met$sha256[ix[,1]]) & !is.na(met$sha256[ix[,2]]) &
                                met$sha256[ix[,1]] == met$sha256[ix[,2]]) |>
      mutate(Tipo = ifelse(variedad_1 == variedad_2, "Misma variedad nominal", "Variedades diferentes"))
  }
  csv(pares_fotos, "todos_los_pares_de_fotos")
  csv(pares_fotos |> filter(Hash_identico), "pares_con_archivo_identico")
  # -- 3. VARIABILIDAD INTERNA POR VARIEDAD -------------------------------
  variedades <- met |> group_by(variedad_id) |> summarise(
    Variedad = first(variedad_nombre), N_fotos = n(), N_fichas = n_distinct(producto_url),
    L_media = mean(L_media), a_media = mean(a_media), b_media = mean(b_media),
    L_sd_entre_fotos = sd(L_media), a_sd_entre_fotos = sd(a_media), b_sd_entre_fotos = sd(b_media),
    .groups = "drop")
  variedades$Etiqueta <- make.unique(variedades$Variedad, sep = " #")
  etiquetas <- setNames(variedades$Etiqueta, variedades$variedad_id)
  intra <- bind_rows(lapply(variedades$variedad_id, function(v) {
    z <- pares_fotos |> filter(variedad_1 == v, variedad_2 == v, !Hash_identico)
    data.frame(variedad_id = v, N_pares_internos_no_identicos = nrow(z),
               EMD_intra_media = media(z$EMD), EMD_intra_mediana = mediana(z$EMD),
               EMD_intra_maxima = maximo(z$EMD))
  }))
  variedades <- variedades |> left_join(intra, by = "variedad_id") |>
    mutate(Interpretacion_interna = ifelse(N_pares_internos_no_identicos == 0,
                                           "Sin fotos distintas suficientes para evaluar variacion interna", "Variacion descriptiva entre fotos"))
  csv(variedades, "resumen_variabilidad_variedades")
  # -- 4. PALETA DE CADA VARIEDAD: TODAS SUS FOTOS CON IGUAL PESO ----------
  pv <- pal |> left_join(variedades |> select(variedad_id, N_fotos), by = "variedad_id") |>
    mutate(Peso = Peso / N_fotos)
  vid <- variedades$variedad_id; nv <- length(vid)
  pal_v <- lapply(vid, function(v) pv |> filter(variedad_id == v))
  DV <- matrix(0, nv, nv, dimnames = list(vid, vid))
  if (nv > 1) for (i in seq_len(nv - 1L)) for (j in seq.int(i + 1L, nv))
    DV[i,j] <- DV[j,i] <- emd(pal_v[[i]], pal_v[[j]])
  csv(data.frame(variedad_id = vid, DV, check.names = FALSE), "matriz_EMD_variedades")
  pares_var <- data.frame()
  if (nv > 1) {
    ij <- which(upper.tri(DV), arr.ind = TRUE)
    pares_var <- bind_rows(lapply(seq_len(nrow(ij)), function(k) {
      i <- ij[k,1]; j <- ij[k,2]; a <- vid[i]; b <- vid[j]
      za <- which(met$variedad_id == a); zb <- which(met$variedad_id == b)
      # Los pares de archivos exactamente iguales se auditan, no se usan
      # para valorar consistencia ni como vecinos predictivos.
      z <- pares_fotos |> filter((variedad_1 == a & variedad_2 == b) |
                                   (variedad_1 == b & variedad_2 == a)) |> filter(!Hash_identico)
      ia <- variedades$EMD_intra_media[i]; ib <- variedades$EMD_intra_media[j]
      referencia <- if (is.finite(ia) && is.finite(ib)) max(ia, ib) else NA_real_
      data.frame(variedad_1 = a, variedad_2 = b, Nombre_1 = etiquetas[a], Nombre_2 = etiquetas[b],
                 N_fotos_1 = length(za), N_fotos_2 = length(zb), EMD_paletas_variedad = DV[i,j],
                 N_pares_entre_fotos = nrow(z), EMD_entre_fotos_media = media(z$EMD),
                 EMD_entre_fotos_mediana = mediana(z$EMD), EMD_entre_fotos_minima = if(nrow(z)) min(z$EMD) else NA_real_,
                 EMD_intra_1 = ia, EMD_intra_2 = ib,
                 Razon_entre_intra = if (is.finite(referencia) && referencia > TOL_NUMERICA) media(z$EMD)/referencia else NA_real_,
                 Archivos_identicos_compartidos = sum(pares_fotos$Hash_identico &
                                                        ((pares_fotos$variedad_1 == a & pares_fotos$variedad_2 == b) |
                                                           (pares_fotos$variedad_1 == b & pares_fotos$variedad_2 == a))),
                 Comparacion_descriptiva = if (!is.finite(referencia) || !nrow(z)) "Sin repeticion suficiente"
                 else if (media(z$EMD) <= referencia) "Distancia entre fotos no supera la mayor media interna"
                 else "Distancia entre fotos supera ambas medias internas",
                 Identidad = "La similitud cromatica no confirma identidad varietal", row.names = NULL)
    })) |> arrange(EMD_paletas_variedad)
    csv(pares_var, "comparacion_todas_las_variedades")
    csv(head(pares_var, TOP_PARES), "variedades_mas_parecidas")
    csv(head(pares_var |> arrange(desc(EMD_paletas_variedad)), TOP_PARES), "variedades_mas_diferentes")
  }
  # -- 5. VECINOS POR FOTO, EXCLUYENDO LA MISMA FOTO Y EL MISMO HASH -------
  vecinos <- bind_rows(lapply(seq_len(nf), function(i) {
    candidatos <- setdiff(seq_len(nf), i)
    if (!is.na(met$sha256[i])) candidatos <- candidatos[
      is.na(met$sha256[candidatos]) | met$sha256[candidatos] != met$sha256[i]]
    propios <- candidatos[met$variedad_id[candidatos] == met$variedad_id[i]]
    otros <- candidatos[met$variedad_id[candidatos] != met$variedad_id[i]]
    d_propia <- if(length(propios)) min(DF[i, propios]) else NA_real_
    d_otra <- if(length(otros)) min(DF[i, otros]) else NA_real_
    mejor <- if(length(candidatos)) candidatos[which.min(DF[i, candidatos])] else NA_integer_
    estado <- if (!is.finite(d_propia)) "Sin otra foto propia comparable"
    else if (!is.finite(d_otra)) "Sin otras variedades comparables"
    else if (abs(d_propia-d_otra) <= TOL_NUMERICA) "Empate numerico"
    else if (d_propia < d_otra) "Mas cerca de una foto propia"
    else "Mas cerca de una foto de otra variedad"
    data.frame(imagen_id = fotos[i], variedad_id = met$variedad_id[i], Variedad = met$variedad_nombre[i],
               N_referencias_propias = length(propios), N_referencias_otras = length(otros),
               EMD_vecino_propio = d_propia, EMD_vecino_otro = d_otra,
               Margen = d_otra - d_propia, Vecino_id = if(is.na(mejor)) NA_character_ else fotos[mejor],
               Vecino_variedad = if(is.na(mejor)) NA_character_ else met$variedad_nombre[mejor], Estado = estado)
  }))
  csv(vecinos, "vecino_por_foto_sin_autocomparacion")
  csv(vecinos |> filter(Estado == "Mas cerca de una foto de otra variedad"), "fotos_para_revisar")
  # -- 6. FIGURAS -------------------------------------------------------
  propios <- pares_fotos |> filter(Tipo == "Misma variedad nominal", !Hash_identico)
  g_intra <- NULL; g_dist <- NULL; g_nombres <- NULL
  if (nrow(propios)) {
    propios$Variedad <- etiquetas[propios$variedad_1]
    top <- variedades |> filter(is.finite(EMD_intra_media)) |> arrange(desc(EMD_intra_media)) |>
      slice_head(n = 25)
    z <- propios |> filter(variedad_1 %in% top$variedad_id)
    z$Variedad <- factor(z$Variedad, levels = rev(top$Etiqueta))
    g_intra <- ggplot(z, aes(Variedad, EMD)) + geom_boxplot(outlier.shape = NA, fill = "#D3E8EE") +
      geom_jitter(width = .12, height = 0, colour = "#087F8C", size = 1.7, alpha = .7) +
      coord_flip() + tema() + labs(title = "Color variation within each variety",
                                   subtitle = "Photo pairs excluding identical files. Descriptive comparison", x = NULL, y = "EMD")
    guardar(g_intra, "01_variacion_dentro_variedad", 12, max(5, 2+.25*nrow(top)))
  }
  z <- pares_fotos |> filter(!Hash_identico)
  if (nrow(z)) {
    g_dist <- ggplot(z, aes(Tipo, EMD, fill = Tipo)) + geom_boxplot(width = .55, outlier.alpha = .25) +
      scale_fill_manual(values = c("Misma variedad nominal" = "#19A7A0", "Variedades diferentes" = "#DD8452")) +
      scale_x_discrete(labels = c("Misma variedad nominal" = "Same nominal variety",
                                  "Variedades diferentes" = "Different varieties")) +
      tema() + theme(legend.position = "none") + labs(title = "Within-variety variation versus between-variety differences",
                                                      subtitle = "Pairs share photos; they are not independent replicates", x = NULL, y = "EMD between photos")
    guardar(g_dist, "02_dentro_frente_entre")
  }
  if (nv > 1) {
    ord <- vid[hclust(as.dist(DV), method = "average")$order]
    z <- as.data.frame(as.table(DV), stringsAsFactors = FALSE); names(z) <- c("V1", "V2", "EMD")
    g <- ggplot(z, aes(factor(V1, levels = ord), factor(V2, levels = rev(ord)), fill = EMD)) +
      geom_tile() + scale_fill_viridis_c(option = "magma", direction = -1, name = "EMD\nDeltaE00") +
      coord_equal() + tema() + labs(title = "Palette similarity between varieties", x = NULL, y = NULL)
    if(nv <= 60) g <- g + scale_x_discrete(labels = etiquetas) + scale_y_discrete(labels = etiquetas) +
      theme(axis.text.x = element_text(angle = 90, hjust = 1, size = 7), axis.text.y = element_text(size = 7))
    else g <- g + theme(axis.text = element_blank())
    guardar(g, "03_heatmap_variedades", 12, 10)
  }
  # Fotos de una variedad una debajo de otra: el cambio de proporciones es visible.
  met$Etiqueta <- etiquetas[met$variedad_id]
  z <- pal |> left_join(met |> select(imagen_id, Etiqueta), by = "imagen_id") |>
    mutate(tono = atan2(b, a), foto = factor(imagen_id, levels = rev(fotos))) |>
    arrange(imagen_id, tono, L) |> group_by(imagen_id) |>
    mutate(xmax = cumsum(Peso), xmin = xmax - Peso) |> ungroup()
  paginas <- split(vid, ceiling(seq_along(vid) / VARIEDADES_POR_PAGINA))
  for (i in seq_along(paginas)) {
    zz <- z |> filter(variedad_id %in% paginas[[i]])
    g <- ggplot(zz) + geom_segment(aes(x = xmin, xend = xmax, y = foto, yend = foto,
                                       colour = Hex), linewidth = 7, lineend = "butt") + scale_colour_identity() +
      scale_x_continuous(breaks = c(0,.5,1), labels = c("0%","50%","100%")) +
      facet_wrap(~Etiqueta, scales = "free_y", ncol = 2) + tema() +
      theme(panel.grid = element_blank(), axis.text.y = element_text(size = 6)) +
      labs(title = "Photo color composition by variety", x = "Proportion", y = NULL)
    guardar(g, sprintf("04_paletas_fotos_%02d",i), 15, max(5, .25*n_distinct(zz$imagen_id)+2))
  }
  # Medias de cada foto. Barras = rango observado, no IC ni error biologico.
  metricas <- met |> mutate(Croma_del_color_medio = sqrt(a_media^2+b_media^2)) |>
    select(imagen_id, variedad_id, Etiqueta, L_media, a_media, b_media, Croma_del_color_medio) |>
    pivot_longer(c(L_media, a_media, b_media, Croma_del_color_medio), names_to = "Descriptor", values_to = "Valor")
  for (i in seq_along(paginas)) {
    zz <- metricas |> filter(variedad_id %in% paginas[[i]])
    g <- ggplot(zz, aes(Etiqueta, Valor)) +
      stat_summary(fun.min = min, fun.max = max, geom = "errorbar", width = .25, colour = "#087F8C") +
      geom_point(position = position_jitter(width = .1, height = 0, seed = SEMILLA), alpha = .65, size = 1.5) +
      stat_summary(fun = mean, geom = "point", shape = 23, fill = "#DD8452", size = 2.5) +
      facet_wrap(~Descriptor, scales = "free_y", ncol = 2,
        labeller = as_labeller(c(L_media = "Mean L*", a_media = "Mean a*", b_media = "Mean b*",
                                 Croma_del_color_medio = "Chroma of the mean color"))) + tema() +
      theme(axis.text.x = element_text(angle = 55, hjust = 1, size = 8)) +
      labs(title = "Color descriptors by variety",
           subtitle = "Points: photos; diamond: mean; bar: observed minimum and maximum", x = NULL, y = "Value")
    guardar(g, sprintf("05_descriptores_%02d",i), 15, 9)
  }
  if (nrow(pares_var)) {
    top <- head(pares_var, TOP_PARES)
    z <- bind_rows(lapply(seq_len(nrow(top)), function(i) {
      bind_rows(pal_v[[match(top$variedad_1[i], vid)]], pal_v[[match(top$variedad_2[i], vid)]]) |>
        mutate(Comparacion = sprintf("Pair %02d - EMD %.2f", i, top$EMD_paletas_variedad[i]),
               Etiqueta = etiquetas[variedad_id])
    })) |> arrange(Comparacion, variedad_id, L) |> group_by(Comparacion, variedad_id) |>
      mutate(xmax = cumsum(Peso), xmin = xmax-Peso) |> ungroup()
    g <- ggplot(z) + geom_segment(aes(x = xmin, xend = xmax, y = Etiqueta, yend = Etiqueta,
                                      colour = Hex), linewidth = 9, lineend = "butt") + scale_colour_identity() +
      scale_x_continuous(labels = function(x) paste0(100*x,"%")) +
      facet_wrap(~Comparacion, scales = "free_y", ncol = 1) + tema() + theme(panel.grid = element_blank()) +
      labs(title = "Varieties with the most similar palettes", x = "Proportion; equally weighted photos", y = NULL)
    guardar(g, "06_pares_variedades_mas_similares", 12, max(5, 2+1.3*nrow(top)))
  }
  if (!is.null(g_intra) && !is.null(g_dist)) guardar(
    patchwork::wrap_plots(g_intra, g_dist, ncol = 1) + patchwork::plot_annotation(
      title = "Color consistency of varieties",
      caption = "Uncalibrated catalog photos. Color similarity does not confirm genetic identity."),
    "00_panel_variedades", 14, 12)
  salida_obj <- list(variedades = variedades, identidad = met, distancias_fotos = DF,
                     distancias_variedades = DV, pares_fotos = pares_fotos, comparacion_variedades = pares_var,
                     vecinos_fotos = vecinos, archivo_base = archivo_rds,
                     configuracion = list(max_imagenes = MAX_IMAGENES, tolerancia_empates = TOL_NUMERICA,
                                          mapa_manual = file.exists(ruta_mapa), unidad = "Variedad nominal por URL o mapa manual"))
  saveRDS(salida_obj, file.path(salida, "comparacion_variedades.rds"))
  capture.output(sessionInfo(), file = file.path(salida, "sessionInfo.txt"))
  writeLines(c("COMPARACION ENTRE VARIEDADES - GUIA", "",
               "La identidad es nominal: producto_url o mapa_variedades.csv. No se infiere por color.",
               "auditoria_nombres: nombres repetidos entre fichas; revisar posibles sinonimos manualmente.",
               "resumen_variabilidad_variedades: variacion entre fotos propias. Una sola foto no permite evaluarla.",
               "comparacion_todas_las_variedades: distancia de paletas agregadas y media de distancias entre fotos.",
               "EMD_paletas_variedad NO es igual a EMD_entre_fotos_media: responden a preguntas diferentes.",
               "Razon_entre_intra: media entre fotos / mayor media interna. NA si falta repeticion o el denominador es cero.",
               "Una razon <=1 indica solapamiento descriptivo respecto de esa referencia, no igualdad estadistica ni genetica.",
               "Vecinos: excluyen la foto consultada y los archivos con el mismo SHA256.",
               "El numero desigual de fotos afecta los vecinos mas cercanos. Es una revision descriptiva, no una validacion predictiva.",
               "Los pares con SHA256 identico se auditan y se omiten de la variacion entre fotos y vecinos.",
               "Las paletas agregadas conservan todas las fotos seleccionadas en el analisis general: revisar hashes compartidos.",
               "No se usan p-valores porque las fotos de catalogo no son replicas biologicas independientes.",
               "Las barras de descriptores muestran minimo/maximo, no intervalos de confianza.",
               "Sin fotografias calibradas ni mascaras verificadas, las diferencias pueden incluir iluminacion, hojas o tallos.",
               "Para confirmar una misma variedad se requieren datos de identidad/procedencia y, segun el objetivo, marcadores.",
               "Para un mapa manual: copiar plantilla_mapa_variedades.csv a CARPETA_ENTRADA como mapa_variedades.csv,",
               "editar variedad_id y variedad_nombre, conservar producto_url y cubrir todas las URLs incluidas.",
               "Cada foto tiene igual peso dentro de su variedad, incluso si se fusionan varias fichas.",
               "Se reutiliza la seleccion del ultimo analisis general; indicar ARCHIVO_RDS para fijar una ejecucion."),
             file.path(salida, "LEEME_variedades.txt"), useBytes = TRUE)
  message("Comparacion terminada: ", normalizePath(salida, winslash = "/"))
  invisible(salida_obj)
}

if (Sys.getenv("CAPIRO_VARIEDADES_NO_AUTO_RUN") != "1") {
  resultado_variedades <- comparar_variedades()
}




