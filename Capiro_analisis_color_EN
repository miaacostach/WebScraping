# ==================================================================================
# CAPIRO: ANALYSIS OF COLOR RESULTS GENERATED IN PYTHON
# Analysis author: script prepared for Miguel Acosta
# Run in Positron/RStudio with R >= 4.1.
# Does not download or resegment images. Does not modify the original CSV files.
#
# STEPS:
# 1. Set CARPETA_ENTRADA to the output folder generated by the Python script.
# 2. Run this entire file. If packages are missing, run the
#    install.packages(...) command shown in the message, then rerun the script.
# 3. Open the Analisis_R/ejecucion_... subfolder: figures, tables, and objects.
#
# Default UNIDAD: catalog product, identified by producto_url.
# Its photos have equal weight. They are not independent biological replicates.
# DISTANCE: optimal transport between palettes, using CIEDE2000 (D65) as the cost.
# This dissimilarity is based on the compressed palette, not on all pixels.
# It is not numerically comparable to EMD previously calculated in RGB 0..1.
# CIEDE2000 does not guarantee the triangle inequality: the geometry is handled
# through PCoA with a Cailliez correction when necessary.
# DeltaE00 perception thresholds of 1/3/6 are not used to classify this EMD.
#
# Photos are not calibrated, and the mask may include leaves and stems.
# HEX codes represent mean RGB values for displaying colors, not RHS references.
# Lab values exported by Python are preserved: Lab(mean RGB) != mean Lab.
# ==================================================================================


CARPETA_ENTRADA <- "D:/R/Capiro_resultados"
UNIDAD <- "producto"                  # "producto" o "imagen"
VARIABLE_GRUPO <- "categoria"          # "categoria", "obtentor" o "color_catalogo"
SOLO_MASCARAS_MANUALES <- FALSE
QUITAR_DUPLICADAS_DENTRO_PRODUCTO <- TRUE
MAX_UNIDADES_DISTANCIA <- 300L         # Tiempo y memoria crecen aproximadamente con n^2
K_MAX <- 8L
FILAS_POR_PAGINA <- 35L
MAX_ETIQUETAS <- 30L
N_VECINOS <- 5L
PERMUTACIONES <- 999L
HACER_PERMANOVA <- TRUE               # Solo productos, grupos suficientes y sin hashes compartidos
GUARDAR_PDF <- TRUE
SEMILLA <- 42L

# Opcional: crear seleccion_imagenes.csv en CARPETA_ENTRADA con columnas
# imagen_id,incluir,comentario. incluir admite SI/NO, TRUE/FALSE, 1/0.
# Las imagenes no mencionadas se conservan. Se genera una plantilla en
# tablas/para_revisar_imagenes.csv; no es una aprobacion de las mascaras.

analizar_capiro <- function(carpeta = CARPETA_ENTRADA) {
  paquetes <- c("readr", "dplyr", "tidyr", "ggplot2", "farver", "lpSolve",
                "cluster", "ggrepel", "patchwork")
  faltan <- paquetes[!vapply(paquetes, requireNamespace, logical(1), quietly = TRUE)]
  if (length(faltan)) stop("Instalar primero:\ninstall.packages(c(",
    paste(sprintf('"%s"', faltan), collapse = ", "), "))\n",
    "Opcional para PERMANOVA: install.packages(\"vegan\")", call. = FALSE)
  suppressPackageStartupMessages({
    library(dplyr); library(tidyr); library(ggplot2)
  })
  set.seed(SEMILLA)
  stopifnot(UNIDAD %in% c("producto", "imagen"), K_MAX >= 2,
            FILAS_POR_PAGINA >= 1, N_VECINOS >= 1)
  if (!dir.exists(carpeta)) stop("No existe CARPETA_ENTRADA: ", carpeta)
  salida_base <- file.path(carpeta, "Analisis_R")
  dir.create(salida_base, recursive = TRUE, showWarnings = FALSE)
  salida <- file.path(salida_base, paste0("ejecucion_", format(Sys.time(), "%Y%m%d_%H%M%S")))
  if (dir.exists(salida)) salida <- tempfile("ejecucion_", tmpdir = salida_base)
  dir.create(salida)
  for (s in c("figuras", "tablas", "objetos")) dir.create(file.path(salida, s))
  avisos <- character()
  aviso <- function(x) { avisos <<- c(avisos, x); message(x) }
  csv <- function(x, nombre) readr::write_excel_csv(as.data.frame(x),
                         file.path(salida, "tablas", paste0(nombre, ".csv")), na = "")
  leer <- function(nombre, obligatorio = TRUE) {
    ruta <- file.path(carpeta, nombre)
    if (!file.exists(ruta)) {
      if (obligatorio) stop("Falta archivo: ", ruta)
      return(NULL)
    }
    readr::read_csv(ruta, col_types = readr::cols(.default = readr::col_character()),
                   show_col_types = FALSE, progress = FALSE, na = c("", "NA", "NaN"))
  }
  exigir <- function(x, cols, archivo) {
    faltantes <- setdiff(cols, names(x))
    if (length(faltantes)) stop(archivo, ": faltan columnas ", paste(faltantes, collapse = ", "))
  }
  numericas <- function(x, cols, archivo) {
    for (v in cols) {
      original <- x[[v]]
      x[[v]] <- suppressWarnings(as.numeric(original))
      if (any(!is.na(original) & !is.finite(x[[v]])))
        stop(archivo, ": datos no numericos/no finitos en ", v)
    }
    x
  }
  tema <- function() theme_minimal(base_size = 12) + theme(
    plot.title = element_text(face = "bold", colour = "#173F58", size = 16),
    plot.subtitle = element_text(colour = "#526577", size = 10),
    panel.grid.minor = element_blank(), legend.position = "right",
    plot.margin = margin(12, 18, 12, 12))
  guardar <- function(p, nombre, w = 10, h = 7) {
    png_fun <- if (requireNamespace("ragg", quietly = TRUE)) ragg::agg_png else "png"
    ggsave(file.path(salida, "figuras", paste0(nombre, ".png")), p,
           width = w, height = h, units = "in", dpi = 300, bg = "white", device = png_fun)
    if (GUARDAR_PDF) ggsave(file.path(salida, "figuras", paste0(nombre, ".pdf")), p,
           width = w, height = h, units = "in", bg = "white", device = "pdf")
  }
  tabla_matriz <- function(x, nombre) csv(data.frame(unidad_id = rownames(x), x,
                                                      check.names = FALSE), nombre)
  resumen_texto <- function(z) paste(sort(unique(z[!is.na(z)])), collapse = "; ")
  unico <- function(z) {
    z <- unique(z[!is.na(z) & nzchar(trimws(z))])
    if (length(z) == 1L) z else NA_character_
  }
  # ---- 1. LECTURA Y CONTROL DE CALIDAD ---------------------------------
  met <- leer("metricas_color.csv")
  pal <- leer("colores_dominantes.csv")
  meta <- leer("imagenes_metadata.csv", FALSE)
  errores <- leer("errores.csv", FALSE)
  exigir(met, c("imagen_id", "producto_url", "nombre", "L_media", "a_media", "b_media"),
         "metricas_color.csv")
  exigir(pal, c("imagen_id", "L", "a", "b", "R", "G", "B", "Proporcion", "rango_color"),
         "colores_dominantes.csv")
  if (!nrow(met) || !nrow(pal)) stop("No hay resultados de color. Revisar errores.csv y mascaras.")
  if (anyNA(met$imagen_id) || anyDuplicated(met$imagen_id)) stop("imagen_id ausente o repetida en metricas.")
  if (anyNA(met$producto_url)) stop("Falta producto_url: no se puede identificar el producto.")
  met <- numericas(met, intersect(c("L_media", "a_media", "b_media", "L_sd", "a_sd", "b_sd",
    "Croma_medio", "Entropia_paleta", "fraccion_objeto", "k_real"), names(met)), "metricas")
  pal <- numericas(pal, c("L", "a", "b", "R", "G", "B", "Proporcion", "rango_color"), "paletas")
  if (anyNA(pal$imagen_id) || anyDuplicated(pal[c("imagen_id", "rango_color")]))
    stop("Clusters repetidos o imagen_id ausente en paletas.")
  if (anyNA(pal[c("L", "a", "b", "R", "G", "B", "Proporcion")])) stop("Faltan datos en paletas.")
  if (any(pal$Proporcion < 0 | pal$Proporcion > 1)) stop("Proporcion debe estar entre 0 y 1.")
  if (any(pal$L < 0 | pal$L > 100) || any(as.matrix(pal[c("R", "G", "B")]) < 0 |
      as.matrix(pal[c("R", "G", "B")]) > 255)) stop("Revisar rangos de Lab/RGB.")
  if (anyNA(met[c("L_media", "a_media", "b_media")])) stop("Faltan medias Lab.")
  if (length(setdiff(pal$imagen_id, met$imagen_id)) || length(setdiff(met$imagen_id, pal$imagen_id)))
    stop("Los IDs de metricas y paletas no coinciden. Usar CSV de una misma ejecucion Python.")
  sumas <- pal |> group_by(imagen_id) |> summarise(Suma = sum(Proporcion), .groups = "drop")
  csv(sumas, "control_sumas_paletas")
  if (any(abs(sumas$Suma - 1) > .001)) stop("Hay paletas cuya suma difiere de 1 en mas de 0.001.")
  pal <- pal |> left_join(sumas, by = "imagen_id") |> mutate(Proporcion = Proporcion / Suma) |>
    filter(Proporcion > 0)
  # Reconstruir Hex para evitar cadenas no validas y conservar Lab de Python.
  pal$Hex <- grDevices::rgb(pal$R, pal$G, pal$B, maxColorValue = 255)
  pal$Croma <- sqrt(pal$a^2 + pal$b^2)
  pal$Tono <- (atan2(pal$b, pal$a) * 180 / pi + 360) %% 360
  for (v in c("categoria", "obtentor", "color_catalogo", "revision", "metodo_mascara")) {
    if (!v %in% names(met)) met[[v]] <- NA_character_
  }
  if (!VARIABLE_GRUPO %in% names(met)) stop("VARIABLE_GRUPO no existe: ", VARIABLE_GRUPO)
  met$sha256 <- NA_character_
  if (!is.null(meta)) {
    exigir(meta, "imagen_id", "imagenes_metadata.csv")
    if (anyDuplicated(meta$imagen_id)) stop("IDs duplicados en imagenes_metadata.csv.")
    csv(meta |> count(estado_analisis, name = "Imagenes"), "estado_analisis_python")
    if ("sha256" %in% names(meta)) met$sha256 <- meta$sha256[match(met$imagen_id, meta$imagen_id)]
  }
  if (!is.null(errores)) csv(errores, "errores_python")
  met <- met |> arrange(producto_url, imagen_id)
  met$incluir <- TRUE
  met$motivo_exclusion <- ""
  seleccion <- leer("seleccion_imagenes.csv", FALSE)
  if (!is.null(seleccion)) {
    exigir(seleccion, c("imagen_id", "incluir"), "seleccion_imagenes.csv")
    if (anyDuplicated(seleccion$imagen_id) || anyNA(seleccion$imagen_id) ||
        any(!seleccion$imagen_id %in% met$imagen_id)) stop("Seleccion: IDs repetidos, ausentes o desconocidos.")
    flags <- toupper(trimws(seleccion$incluir))
    if (anyNA(flags) || any(!flags %in% c("SI", "SÍ", "NO", "TRUE", "FALSE", "1", "0")))
      stop("Seleccion: incluir debe ser SI/NO, TRUE/FALSE o 1/0.")
    ix <- match(met$imagen_id, seleccion$imagen_id)
    met$incluir <- is.na(ix) | flags[ix] %in% c("SI", "SÍ", "TRUE", "1")
    met$motivo_exclusion[!met$incluir] <- "exclusion_manual"
  }
  if (SOLO_MASCARAS_MANUALES) {
    quitar <- is.na(met$metodo_mascara) | met$metodo_mascara != "manual"
    met$incluir[quitar] <- FALSE
    met$motivo_exclusion[quitar] <- "mascara_no_manual"
  }
  # Deduplicar solo entre fotos incluidas del mismo producto.
  met$duplicada_producto <- FALSE
  ind <- which(met$incluir & !is.na(met$sha256))
  met$duplicada_producto[ind] <- duplicated(met[ind, c("producto_url", "sha256")])
  if (QUITAR_DUPLICADAS_DENTRO_PRODUCTO) {
    met$incluir[met$duplicada_producto] <- FALSE
    met$motivo_exclusion[met$duplicada_producto] <- "foto_identica_dentro_producto"
  }
  csv(met, "auditoria_imagenes")
  csv(met |> select(imagen_id, nombre, categoria, revision, metodo_mascara, incluir) |>
        mutate(comentario = "Revisar la imagen de la carpeta revision antes de decidir"),
      "para_revisar_imagenes")
  met <- met |> filter(incluir)
  if (!nrow(met)) stop("No quedan imagenes despues de los filtros.")
  compartidas <- met |> filter(!is.na(sha256)) |> group_by(sha256) |>
    summarise(N_productos = n_distinct(producto_url), Productos = resumen_texto(producto_url),
              .groups = "drop") |> filter(N_productos > 1)
  csv(compartidas, "fotos_identicas_entre_productos")
  if (nrow(compartidas)) aviso("Hay fotos identicas compartidas por productos: ver tabla; PERMANOVA se omitira.")
  if (any(is.na(met$metodo_mascara) | met$metodo_mascara != "manual"))
    aviso("Analisis exploratorio: revisar mascaras automaticas y posibles hojas/tallos.")
  met$unidad_id <- if (UNIDAD == "producto") met$producto_url else met$imagen_id
  pal <- pal |> select(imagen_id, rango_color, L, a, b, R, G, B, Hex, Proporcion, Croma, Tono) |>
    inner_join(met |> select(imagen_id, unidad_id), by = "imagen_id")

  # ---- 2. PRODUCTOS / IMAGENES Y PALETAS -------------------------------
  # Cada foto contribuye con masa 1/n_fotos, sin favorecer resoluciones altas.
  descriptores <- intersect(c("L_media", "a_media", "b_media", "Croma_medio",
                              "L_sd", "a_sd", "b_sd", "Entropia_paleta"), names(met))
  unidades <- met |> group_by(unidad_id) |> summarise(
    nombre = unico(nombre), categoria = unico(categoria), obtentor = unico(obtentor),
    color_catalogo = unico(color_catalogo), producto_url = unico(producto_url),
    n_fotos = n(), across(all_of(descriptores), ~ if (all(is.finite(.x))) mean(.x) else NA_real_),
    .groups = "drop")
  unidades$nombre[is.na(unidades$nombre)] <- "Nombre no unico"
  unidades$Etiqueta <- make.unique(unidades$nombre, sep = " #")
  if (UNIDAD == "imagen") unidades$Etiqueta <- paste(unidades$Etiqueta,
    sub(".*_([0-9]+)$", "foto \\1", unidades$unidad_id))
  unidades$Grupo <- unidades[[VARIABLE_GRUPO]]
  unidades$Grupo[is.na(unidades$Grupo) | !nzchar(trimws(unidades$Grupo))] <- "Sin dato"
  pal <- pal |> left_join(unidades |> select(unidad_id, n_fotos), by = "unidad_id") |>
    mutate(Peso = Proporcion / n_fotos)
  ids <- unidades$unidad_id
  n <- length(ids)
  if (n > MAX_UNIDADES_DISTANCIA) stop("Hay ", n, " unidades. Aumentar MAX_UNIDADES_DISTANCIA (coste n^2),",
    " usar UNIDAD='producto' o seleccionar imagenes. No se submuestrean datos silenciosamente.")
  paletas <- lapply(ids, function(id) pal |> filter(unidad_id == id))
  names(paletas) <- ids
  etiquetas <- setNames(unidades$Etiqueta, ids)
  # Identificador del dominante: cluster individual de mayor masa en la mezcla.
  # No implica que clusters de fotos diferentes tengan la misma identidad.
  dominantes <- pal |> group_by(unidad_id) |> arrange(desc(Peso), imagen_id, rango_color, .by_group = TRUE) |>
    slice_head(n = 1) |> ungroup() |> select(unidad_id, Hex_representativo = Hex)
  unidades <- unidades |> left_join(dominantes, by = "unidad_id")
  csv(pal, "paletas_utilizadas")
  # El Lab medio ponderado de los centroides coincide con el Lab medio del objeto.
  control_lab <- pal |> group_by(unidad_id) |> summarise(
    L_paleta = sum(Peso * L), a_paleta = sum(Peso * a), b_paleta = sum(Peso * b), .groups = "drop") |>
    left_join(unidades |> select(unidad_id, L_media, a_media, b_media), by = "unidad_id") |>
    mutate(error_maximo = pmax(abs(L_paleta - L_media), abs(a_paleta - a_media), abs(b_paleta - b_media)))
  csv(control_lab, "control_coherencia_Lab")
  if (any(control_lab$error_maximo > .01)) stop("Metricas y paletas tienen medias Lab inconsistentes.")

  # ---- 3. TRANSPORTE OPTIMO: EMD CON COSTE DELTA E 2000 -----------------
  delta <- function(a, b) farver::compare_colour(as.matrix(a), as.matrix(b),
        from_space = "lab", to_space = "lab", method = "cie2000",
        white_from = "D65", white_to = "D65")
  emd <- function(a, b) {
    coste <- delta(a[c("L", "a", "b")], b[c("L", "a", "b")])
    m <- nrow(a); q <- nrow(b)
    # Variables x_ij en orden por columnas de la matriz m x q.
    restricciones <- rbind(kronecker(matrix(1, 1, q), diag(m)),
                            kronecker(diag(q), matrix(1, 1, m)))
    wa <- a$Peso / sum(a$Peso); wb <- b$Peso / sum(b$Peso)
    ajuste <- lpSolve::lp("min", as.vector(coste), restricciones,
                         rep("=", m + q), c(wa, wb), all.int = FALSE)
    if (ajuste$status != 0) stop("El transporte optimo no convergio. Estado: ", ajuste$status)
    flujo <- matrix(ajuste$solution, nrow = m, ncol = q)
    if (max(abs(rowSums(flujo) - wa), abs(colSums(flujo) - wb)) > 1e-6 || min(flujo) < -1e-8)
      stop("El transporte no cumple la conservacion de masas.")
    max(0, ajuste$objval)
  }
  D <- matrix(0, n, n, dimnames = list(ids, ids))
  if (n >= 2) {
    message("Comparando ", n, " unidades: ", choose(n, 2), " pares...")
    for (i in seq_len(n - 1L)) {
      for (j in seq.int(i + 1L, n)) D[i, j] <- D[j, i] <- emd(paletas[[i]], paletas[[j]])
      if (i %% 10L == 0L) message("  Fila ", i, " de ", n - 1L)
    }
  }
  if (any(!is.finite(D)) || any(D < -1e-8) || max(abs(D - t(D))) > 1e-8)
    stop("Matriz de distancias invalida. No se reemplazan NA por cero.")
  tabla_matriz(D, "matriz_EMD_DeltaE00")
  # Comparacion complementaria entre colores medios: no mide toda la paleta.
  de_medias <- delta(unidades[c("L_media", "a_media", "b_media")],
                     unidades[c("L_media", "a_media", "b_media")])
  dimnames(de_medias) <- list(ids, ids); diag(de_medias) <- 0
  tabla_matriz(de_medias, "matriz_DeltaE00_colores_medios")
  pares <- data.frame()
  vecinos <- data.frame()
  if (n >= 2) {
    ij <- which(upper.tri(D), arr.ind = TRUE)
    pares <- data.frame(id_1 = ids[ij[, 1]], id_2 = ids[ij[, 2]],
       Nombre_1 = unidades$Etiqueta[ij[, 1]], Nombre_2 = unidades$Etiqueta[ij[, 2]],
       EMD = D[ij], DeltaE00_media = de_medias[ij]) |> arrange(EMD)
    csv(pares, "todos_los_pares")
    csv(head(pares, 20), "20_pares_mas_similares")
    csv(head(pares |> arrange(desc(EMD)), 20), "20_pares_mas_diferentes")
    vecinos <- bind_rows(lapply(seq_len(n), function(i) {
      candidatos <- setdiff(seq_len(n), i)
      z <- head(candidatos[order(D[i, candidatos])], N_VECINOS)
      data.frame(unidad_id = ids[i], Nombre = unidades$Etiqueta[i], Orden = seq_along(z),
                 Vecino_id = ids[z], Vecino = unidades$Etiqueta[z], EMD = D[i, z])
    }))
    csv(vecinos, "vecinos_mas_parecidos")
  }

  # ---- 4. UPGMA Y PAM SOBRE LA DISIMILITUD ORIGINAL ---------------------
  hc <- NULL; pam <- NULL; k_elegido <- NA_integer_; evaluacion <- data.frame()
  orden <- seq_len(n)
  unidades$Cluster_PAM <- factor(rep("Sin agrupamiento", n))
  if (n >= 2) {
    hc <- hclust(as.dist(D), method = "average")
    orden <- hc$order
  }
  k_limite <- min(K_MAX, n - 1L, nrow(unique(as.data.frame(round(D, 8)))))
  if (n >= 3 && max(D) > 1e-8 && k_limite >= 2) {
    ks <- seq.int(2L, k_limite)
    modelos <- lapply(ks, function(k) tryCatch(cluster::pam(as.dist(D), k = k, diss = TRUE),
                                   error = function(e) NULL))
    sil <- vapply(modelos, function(m) if (is.null(m)) NA_real_ else m$silinfo$avg.width, numeric(1))
    evaluacion <- data.frame(k = ks, Silueta_media = sil)
    csv(evaluacion, "seleccion_k_PAM")
    if (any(is.finite(sil))) {
      mejor <- which.max(replace(sil, !is.finite(sil), -Inf))
      k_elegido <- ks[mejor]; pam <- modelos[[mejor]]
      unidades$Cluster_PAM <- factor(paste0("C", pam$clustering))
      unidades$Es_medoide <- seq_len(n) %in% pam$id.med
      unidades$Silueta <- cluster::silhouette(pam$clustering, as.dist(D))[, "sil_width"]
      aviso(sprintf("PAM exploratorio: k=%d, silueta media=%.3f. No prueba grupos naturales.", k_elegido, sil[mejor]))
    }
  }
  # ---- 5. PALETAS EN EL ORDEN DEL DENDROGRAMA --------------------------
  orden_ids <- ids[orden]
  # Se ordenan por tono y luminosidad, sin emparejar rangos arbitrarios entre fotos.
  vista <- pal |> arrange(unidad_id, Tono, L, imagen_id, rango_color) |> group_by(unidad_id) |>
    mutate(xmax = cumsum(Peso), xmin = xmax - Peso) |> ungroup()
  paginas <- split(orden_ids, ceiling(seq_along(orden_ids) / FILAS_POR_PAGINA))
  for (p in seq_along(paginas)) {
    idp <- paginas[[p]]
    z <- vista |> filter(unidad_id %in% idp) |> mutate(y = match(unidad_id, rev(idp)))
    g <- ggplot(z) + geom_rect(aes(xmin = xmin, xmax = xmax, ymin = y - .36,
             ymax = y + .36, fill = Hex), colour = NA) + scale_fill_identity() +
      scale_y_continuous(breaks = seq_along(idp), labels = etiquetas[rev(idp)]) +
      scale_x_continuous(breaks = seq(0, 1, .25), labels = function(x) paste0(100*x, "%"),
                         expand = expansion(mult = c(0, .01))) +
      labs(title = "Color palette atlas", subtitle = paste("Unit:", if (UNIDAD == "producto") "product" else "image",
        "- equally weighted photos - UPGMA order - page", p), x = "Proportion", y = NULL) +
      tema() + theme(panel.grid = element_blank(), axis.text.y = element_text(size = 9))
    guardar(g, sprintf("01_paletas_%02d", p), 12, max(4, 1.8 + .24 * length(idp)))
  }

  # ---- 6. HEATMAP CON LEYENDA EXPLICITA --------------------------------
  if (n >= 2) {
    mapa <- as.data.frame(as.table(D), stringsAsFactors = FALSE)
    names(mapa) <- c("Fila", "Columna", "EMD")
    g_heat <- ggplot(mapa, aes(factor(Columna, levels = orden_ids),
          factor(Fila, levels = rev(orden_ids)), fill = EMD)) + geom_tile() +
      scale_fill_viridis_c(option = "magma", name = "EMD\nDeltaE00 cost", direction = -1) +
      coord_equal() + labs(title = "Similarity between palettes", subtitle =
        "Lower values indicate more similar palettes; UPGMA order", x = NULL, y = NULL) + tema()
    if (n <= 60) g_heat <- g_heat + scale_x_discrete(labels = etiquetas) +
      scale_y_discrete(labels = etiquetas) + theme(axis.text.x = element_text(angle = 90, hjust = 1,
      vjust = .5, size = 6), axis.text.y = element_text(size = 6))
    else g_heat <- g_heat + theme(axis.text = element_blank(), axis.ticks = element_blank())
    guardar(g_heat, "02_heatmap_EMD", 12, 10)
    # Dendrograma base legible por PDF de ancho ajustable.
    dibujar_arbol <- function() {
      par(mar = c(10, 4, 4, 2))
      arbol_vista <- hc
      arbol_vista$labels <- unidades$Etiqueta
      plot(as.dendrogram(arbol_vista), leaflab = "perpendicular",
           nodePar = list(lab.cex = max(.35, min(.8, 30/n)), pch = NA),
           main = "UPGMA clustering of palettes", xlab = "", sub = "Height: EMD with DeltaE00 cost", ylab = "Dissimilarity")
      # Los rectangulos son un corte del arbol, no los grupos PAM.
      if (!is.na(k_elegido)) rect.hclust(hc, k = k_elegido,
                                       border = grDevices::hcl.colors(k_elegido, "Dark 3"))
    }
    grDevices::png(file.path(salida, "figuras", "03_dendrograma_UPGMA.png"),
                   width = max(12, n * .12), height = 8, units = "in", res = 220)
    tryCatch(dibujar_arbol(), finally = grDevices::dev.off())
    if (GUARDAR_PDF) {
      grDevices::pdf(file.path(salida, "figuras", "03_dendrograma_UPGMA.pdf"),
                     width = max(12, n * .12), height = 8)
      tryCatch(dibujar_arbol(), finally = grDevices::dev.off())
    }
  }

  # ---- 7. PCoA: RESPETA LAS DISTANCIAS ENTRE PALETAS --------------------
  pcoa <- NULL; g_pcoa <- NULL; scores_pcoa <- NULL
  if (n >= 3 && max(D) > 1e-8) {
    primera <- cmdscale(as.dist(D), k = min(2L, n - 1L), eig = TRUE)
    corregir <- min(primera$eig) < -1e-8 * max(1, max(primera$eig))
    pcoa <- if (corregir) cmdscale(as.dist(D), k = min(2L, n - 1L), eig = TRUE, add = TRUE) else primera
    eig_pos <- pmax(pcoa$eig, 0)
    pct <- 100 * eig_pos / sum(eig_pos)
    csv(data.frame(Eje = seq_along(pcoa$eig), Autovalor = pcoa$eig, Porcentaje = pct), "PCoA_autovalores")
    puntos <- as.matrix(pcoa$points)
    if (ncol(puntos) >= 2) {
      scores_pcoa <- unidades |> mutate(PCoA1 = puntos[, 1], PCoA2 = puntos[, 2])
      base_pcoa <- ggplot(scores_pcoa, aes(PCoA1, PCoA2)) +
        geom_hline(yintercept = 0, colour = "grey85", linewidth = .3) +
        geom_vline(xintercept = 0, colour = "grey85", linewidth = .3) + coord_equal() + tema() +
        labs(x = sprintf("PCoA1 (%.1f%%)", pct[1]), y = sprintf("PCoA2 (%.1f%%)", pct[2]),
             subtitle = if (corregir) sprintf("Cailliez: c = %.4f; percentages based on corrected distances", pcoa$ac)
             else "Percentages based on positive eigenvalues")
      g_pcoa <- base_pcoa + geom_point(aes(fill = Hex_representativo), shape = 21,
        colour = "grey25", size = 4, stroke = .35) + scale_fill_identity() +
        labs(title = "Palette similarity map")
      if (n <= MAX_ETIQUETAS) g_pcoa <- g_pcoa + ggrepel::geom_text_repel(
        aes(label = Etiqueta), size = 3, max.overlaps = Inf, seed = SEMILLA)
      guardar(g_pcoa, "04_PCoA_color")
      guardar(base_pcoa + geom_point(aes(colour = Grupo), size = 3, alpha = .85) +
        labs(title = "PCoA by catalog group", colour = c(categoria = "Category", obtentor = "Breeder", color_catalogo = "Catalog color")[[VARIABLE_GRUPO]]), "05_PCoA_grupos")
      if (!is.null(pam)) guardar(base_pcoa + geom_point(aes(colour = Cluster_PAM), size = 3) +
        labs(title = paste("PAM clustering of palettes: k =", k_elegido), colour = "PAM"), "06_PCoA_PAM")
      csv(scores_pcoa, "PCoA_coordenadas")
    } else aviso("PCoA: solo hay un eje positivo; se omite el grafico 2D.")
  }

  # ---- 8. ESPACIO CIELAB Y DIVERSIDAD DENTRO DE LAS FOTOS ---------------
  g_lab <- ggplot(pal, aes(a, b, fill = Hex, size = Peso)) +
    geom_hline(yintercept = 0, colour = "grey80") + geom_vline(xintercept = 0, colour = "grey80") +
    geom_point(shape = 21, colour = "grey25", alpha = .85, stroke = .2) + scale_fill_identity() +
    scale_size_continuous(range = c(1, 8), name = "Weight within\nthe unit") + coord_equal() + tema() +
    labs(title = "Colors in the CIELAB plane", subtitle = "Each point is a centroid. L* is not shown in this plane",
      x = "a* (negative: green / positive: red)", y = "b* (negative: blue / positive: yellow)")
  guardar(g_lab, "07_espacio_CIELAB")
  g_lc <- ggplot(unidades, aes(L_media, sqrt(a_media^2 + b_media^2))) +
    geom_point(aes(fill = Hex_representativo), shape = 21, size = 4, colour = "grey25") +
    scale_fill_identity() + tema() + labs(title = "Lightness and chroma of the mean color",
      subtitle = "Each point represents a unit; the fill shows a representative cluster",
      x = "Mean L* (dark to light)", y = "Chroma (C*) of the mean color")
  guardar(g_lc, "08_luminosidad_croma")
  g_div <- NULL
  if ("Entropia_paleta" %in% names(unidades)) {
    z <- unidades |> arrange(desc(Entropia_paleta)) |> slice_head(n = 30)
    g_div <- ggplot(z, aes(reorder(Etiqueta, Entropia_paleta), Entropia_paleta,
                           fill = Hex_representativo)) + geom_col(width = .75, colour = "grey60") +
      scale_fill_identity() + coord_flip() + tema() + labs(title = "Palette diversity",
        subtitle = "Mean photo entropy (bits). Depends on k and segmentation",
        x = NULL, y = "Mean entropy per photo")
    guardar(g_div, "09_diversidad_paletas", 11, max(5, 2 + .2 * nrow(z)))
  }
  if (nrow(evaluacion)) guardar(ggplot(evaluacion, aes(k, Silueta_media)) + geom_line() +
    geom_point(size = 3, colour = "#008B8B") + scale_x_continuous(breaks = evaluacion$k) + tema() +
    labs(title = "Exploratory selection of k", subtitle = "PAM uses the original EMD; a low silhouette indicates weak separation",
         y = "Mean silhouette width"), "10_seleccion_k")

  # ---- 9. PCA COMPLEMENTARIO: DESCRIPTORES DE LAS FOTOS -----------------
  # No se rellenan colores ausentes con cero ni se empareja Color_1 de una
  # foto con Color_1 de otra. No se incluye la distancia a nombres de colors().
  pca <- NULL
  vars <- intersect(c("L_media", "a_media", "b_media", "L_sd", "a_sd", "b_sd", "Entropia_paleta"),
                    names(unidades))
  if (n >= 3) {
    X <- as.data.frame(unidades[vars])
    disponibles <- vapply(X, function(z) all(is.finite(z)) && sd(z) > 1e-10, logical(1))
    csv(data.frame(Variable = vars, Utilizada = disponibles), "PCA_variables")
    X <- X[, disponibles, drop = FALSE]
    if (ncol(X) >= 2) {
      rownames(X) <- ids
      pca <- prcomp(X, center = TRUE, scale. = TRUE)
      vp <- 100 * pca$sdev^2 / sum(pca$sdev^2)
      sc <- unidades |> mutate(PC1 = pca$x[, 1], PC2 = pca$x[, 2])
      csv(sc, "PCA_coordenadas")
      csv(data.frame(Variable = rownames(pca$rotation), pca$rotation), "PCA_cargas")
      csv(data.frame(Eje = seq_along(vp), Porcentaje = vp), "PCA_varianza")
      guardar(ggplot(sc, aes(PC1, PC2, fill = Hex_representativo)) +
        geom_point(shape = 21, size = 4, colour = "grey25") + scale_fill_identity() + tema() +
        coord_equal() + labs(title = "PCA of standardized color descriptors",
          subtitle = "Complements PCoA; summarizes means and within-photo variation",
          x = sprintf("PC1 (%.1f%%)", vp[1]), y = sprintf("PC2 (%.1f%%)", vp[2])), "11_PCA_descriptores")
    } else aviso("PCA omitido: menos de dos descriptores completos con variacion.")
  }

  # ---- 10. GRUPOS DEL CATALOGO: PERMANOVA + DISPERSION -----------------
  csv(unidades |> count(Grupo, name = "N_unidades"), "tamano_grupos")
  permanova <- NULL; dispersion <- NULL
  # Comparaciones independientes de producto: no probar los clusters PAM
  # contra la misma distancia que los creo. El analisis es exploratorio.
  valido <- unidades$Grupo != "Sin dato"
  tam <- table(unidades$Grupo[valido])
  motivo <- NULL
  if (!HACER_PERMANOVA) motivo <- "desactivada en configuracion"
  else if (UNIDAD != "producto") motivo <- "las fotos del mismo producto no son independientes"
  else if (!requireNamespace("vegan", quietly = TRUE)) motivo <- "falta vegan (install.packages('vegan'))"
  else if (nrow(compartidas)) motivo <- "hay fotos identicas compartidas entre productos"
  else if (length(tam) < 2 || any(tam < 3)) motivo <- "se requieren al menos dos grupos con >=3 productos en cada uno"
  else if (max(D) <= 1e-8) motivo <- "todas las distancias son cero"
  if (is.null(motivo)) {
    dg <- as.dist(D[valido, valido, drop = FALSE])
    mg <- data.frame(Grupo = factor(unidades$Grupo[valido]))
    analisis_grupo <- tryCatch({
      a <- vegan::adonis2(dg ~ Grupo, data = mg, permutations = PERMUTACIONES, add = "cailliez")
      b <- vegan::betadisper(dg, mg$Grupo, type = "median", bias.adjust = TRUE, add = "cailliez")
      bt <- vegan::permutest(b, permutations = PERMUTACIONES)
      list(a = a, b = b, bt = bt)
    }, error = function(e) { aviso(paste("Analisis de grupos omitido:", conditionMessage(e))); NULL })
    if (!is.null(analisis_grupo)) {
      permanova <- analisis_grupo$a; dispersion <- analisis_grupo$b
      csv(data.frame(Termino = rownames(permanova), as.data.frame(permanova)), "PERMANOVA")
      csv(data.frame(Termino = rownames(analisis_grupo$bt$tab), as.data.frame(analisis_grupo$bt$tab)),
          "PERMDISP")
      dz <- data.frame(Grupo = mg$Grupo, Distancia = dispersion$distances)
      guardar(ggplot(dz, aes(Grupo, Distancia, colour = Grupo)) + geom_boxplot(outlier.shape = NA) +
        geom_jitter(width = .1, height = 0, alpha = .65) + tema() + theme(legend.position = "none") +
        labs(title = "Palette dispersion within each group", x = c(categoria = "Category", obtentor = "Breeder", color_catalogo = "Catalog color")[[VARIABLE_GRUPO]],
             y = "Distance to the spatial median (corrected geometry)"), "12_dispersion_grupos")
      aviso("PERMANOVA exploratoria: interpretar R2 y p junto con PERMDISP, tamanos y contexto del catalogo.")
    }
  } else aviso(paste("PERMANOVA omitida:", motivo))

  # ---- 11. RELACION ENTRE METRICAS Y PANEL RESUMEN ----------------------
  g_rel <- NULL
  if (nrow(pares)) {
    g_rel <- ggplot(pares, aes(DeltaE00_media, EMD)) + geom_point(alpha = .35, size = 1.6,
      colour = "#167D9A") + tema() + labs(title = "Mean color versus full palette",
      subtitle = "Descriptive pairs sharing units: observations are not independent",
      x = "DeltaE00 between mean colors", y = "EMD between palettes")
    guardar(g_rel, "13_comparacion_distancias")
  }
  paneles <- Filter(Negate(is.null), list(g_pcoa, g_lab, g_lc, g_rel))
  if (length(paneles)) {
    panel <- patchwork::wrap_plots(paneles, ncol = 2) + patchwork::plot_annotation(
      title = "Capiro: catalog color overview",
      subtitle = paste(n, "units |", nrow(met), "photos included | distance between palettes"),
      caption = "Exploration of uncalibrated published photos. The object may include leaves and stems.")
    guardar(panel, "00_panel_resumen", 17, 12)
  }
  csv(unidades, "resumen_por_unidad")
  resultado <- list(unidades = unidades, imagenes = met, paletas = pal,
    distancia_emd = as.dist(D), deltaE00_medias = de_medias, pcoa = pcoa, pca = pca,
    pam = pam, upgma = hc, evaluacion_k = evaluacion, vecinos = vecinos,
    permanova = permanova, dispersion = dispersion, avisos = avisos,
    configuracion = list(carpeta = carpeta, unidad = UNIDAD, grupo = VARIABLE_GRUPO,
      solo_manual = SOLO_MASCARAS_MANUALES, quitar_duplicadas = QUITAR_DUPLICADAS_DENTRO_PRODUCTO,
      k_max = K_MAX, semilla = SEMILLA, permutaciones = PERMUTACIONES))
  saveRDS(resultado, file.path(salida, "objetos", "analisis_completo.rds"))
  capture.output(sessionInfo(), file = file.path(salida, "objetos", "sessionInfo.txt"))
  guia <- c("CAPIRO - LECTURA DE LOS RESULTADOS", "",
    paste("Unidad:", UNIDAD, "| Unidades:", n, "| Fotos:", nrow(met)),
    "00_panel_resumen: vista general. 01_paletas: composicion real en Hex.",
    "02_heatmap: EMD baja indica mayor similitud; leyenda con coste DeltaE00.",
    "03_dendrograma: UPGMA. Rectangulos = corte jerarquico, distintos de PAM.",
    "04_PCoA: cercania entre paletas; comprobar porcentaje de los dos ejes.",
    "05_PCoA_grupos: grupos del catalogo. 06_PCoA_PAM: grupos exploratorios.",
    "07_CIELAB: a* y b*, omite L*. 08_luminosidad_croma: color medio.",
    "09_diversidad: entropia media por foto, depende del k y de las mascaras.",
    "10_seleccion_k: maxima silueta entre valores evaluados, no demuestra grupos naturales.",
    "11_PCA: estandariza descriptores, no es una PCA de colores faltantes rellenados con cero.",
    "12_dispersion: complemento de PERMANOVA. Puede omitirse por falta de grupos o vegan.",
    "13_comparacion: medias y paletas pueden diferir en su patron de similitud.",
    "", "METODO Y LIMITES", "Fotos por producto con igual peso. Mezcla de paletas sin reclusterizar.",
    "EMD = minimo sum(x_ij * DeltaE00_ij), conservando las proporciones de ambas paletas.",
    "Lab D65 exportado por Python. Hex basado en RGB solo para visualizacion.",
    "No comparar su escala con EMD RGB ni aplicar umbrales de perceptibilidad del DeltaE00 a EMD.",
    "PCoA corrige autovalores negativos con Cailliez; UPGMA y PAM usan EMD original.",
    "Las SD y entropias agregadas son medias por foto, no una SD/entropia conjunta del producto.",
    "Cada grupo usa sus productos disponibles. No se rellenan NA con cero.",
    "Las fotos no calibradas no prueban diferencias biologicas de pigmentacion.",
    "Revisar imagenes en revision y mascaras antes de interpretar color de petalos.",
    "Sin asignacion RHS: hace falta una tabla de referencia real y condiciones compatibles.",
    "", "REFERENCIAS TECNICAS", "https://search.r-project.org/CRAN/refmans/farver/html/compare_colour.html",
    "https://search.r-project.org/CRAN/refmans/lpSolve/html/lp.html",
    "https://stat.ethz.ch/R-manual/R-patched/library/stats/html/cmdscale.html",
    "https://search.r-project.org/CRAN/refmans/cluster/html/pam.html",
    "https://vegandevs.github.io/vegan/reference/adonis.html", "", "AVISOS DE ESTA EJECUCION", avisos)
  writeLines(guia, file.path(salida, "LEEME_resultados.txt"), useBytes = TRUE)
  message("Terminado. Resultados en: ", normalizePath(salida, winslash = "/"))
  invisible(resultado)
}

